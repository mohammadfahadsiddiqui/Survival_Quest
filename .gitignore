# Unity .gitignore
# GitHub official Unity .gitignore template with recursive path support

[Aa]ssets/AssetStoreTools*

# Visual Studio / VS Code cache directory
.vs/
**/.vs/
.vscode/
**/.vscode/

# Gradle cache directory
.gradle/
**/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
**/ExportedObj/
.consulo/
**/.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D Generated File On Crash Reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary cache files / folders
[Ll]ibrary/
**/[Ll]ibrary/
[Tt]emp/
**/[Tt]emp/
[Oo]bj/
**/[Oo]bj/
[Bb]uild/
**/[Bb]uild/
[Bb]uilds/
**/[Bb]uilds/
[Ll]ogs/
**/[Ll]ogs/
[Uu]ser[Ss]ettings/
**/[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
**/[Mm]emoryCaptures/
[Rr]ecordings/
**/[Rr]ecordings/

# OS generated files
.DS_Store
Thumbs.db
desktop.ini
